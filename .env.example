# ===== AP1 环境变量模板 =====
# 复制为 .env 或按此注入容器环境。密钥（API Key）不进仓库、不进文档。

# 运行形态
ENV=dev                 # dev / prod：隔离由独立数据库实例承载，不落表列
LOG_LEVEL=INFO
# LOG_FILE=/var/log/ap1.log   # 可选：结构化日志另落文件

# MySQL（事实源）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=ap1
MYSQL_PASSWORD=ap1
MYSQL_DB=ap1

# qdrant（偶像知识 / 歌词向量）
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=idol_knowledge

# redis（MVP 仅拉起、无业务消费者）
REDIS_URL=redis://127.0.0.1:6379/0

# 模型（DeepSeek / OpenAI 兼容 chat）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# 联网搜索 mcp（Tavily 兼容）
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_API_KEY=

# 向量化：openai_compatible = 硅基流动 SiliconFlow（BAAI/bge-m3，1024 维）
#   EMBED_API_KEY 必填；本地无密钥调试请临时改回 EMBED_PROVIDER=local（离线 n-gram）
#   实际维度由 embedder 首个请求自动探测，无需手工对齐
EMBED_PROVIDER=openai_compatible
EMBED_MODEL=BAAI/bge-m3
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_DIM=1024
EMBED_MAX_INPUT_CHARS=6000

# 上下文窗口与压缩
WINDOW_TOKEN_BUDGET=6000
KEEP_RECENT_TURNS=10

# Agent 执行护栏
MAX_RUN_STEPS=8
